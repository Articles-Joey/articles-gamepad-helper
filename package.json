{
  "name": "@articles-media/articles-gamepad-helper",
  "description": "Shared code and assets for games using React.js and gamepad/controller input, including a pie menu and on-screen controller keyboard.",
  "version": "0.0.13",
  "type": "module",
  "imports": {
    "#root/src/*": "./src/*",
    "#root/dist/*": "./dist/*",
    "#root/public/*": "./public/*"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Articles-Joey/articles-gamepad-helper.git"
  },
  "exports": {
    ".": "./dist/index.js",
    "./GamepadPreview": "./dist/GamepadPreview.js",
    "./GamepadKeyboard": "./dist/GamepadKeyboard.js",
    "./PieMenu": "./dist/PieMenu.js",
    "./PieKeyboard": "./dist/PieKeyboard.js",
    "./XboxIcons": "./dist/XboxIcons.js",
    "./SteamIcons": "./dist/SteamIcons.js",
    "./ControllerConnectionWatcher": "./dist/ControllerConnectionWatcher.js",
    "./useGameControllerKeyboardStore": "./dist/useGameControllerKeyboardStore.js",
    "./usePieMenuStore": "./dist/usePieMenuStore.js",
    "./attributions": "./dist/attributions.json",
    "./credits": "./dist/credits.json",
    "./dist/img/*": "./dist/img/*",
    "./dist/style.css": "./dist/articles-gamepad-helper.css",
    "./dist/articles-gamepad-helper.css": "./dist/articles-gamepad-helper.css"
  },
  "scripts": {
    "dev-unknown": "vite dev",
    "dev": "nodemon --watch src --ext js,ts,css,scss,jsx,json --ignore dist --exec \"npm run build\"",
    "build": "vite build",
    "preview": "vite preview",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "Articles Media",
  "license": "ISC",
  "peerDependencies": {
    "react": ">=19.2.4",
    "react-dom": ">=19.2.4",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.1",
    "classnames": "^2.5.1",
    "nodemon": "^3.1.14",
    "react-bootstrap": "^2.10.10",
    "sass": "^1.97.2",
    "vite": "^8.0.3"
  },
  "dependencies": {}
}